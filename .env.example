# Copy to .env and fill in. Never commit .env.
# WordPress user and APPLICATION password (wp-admin > Users > Profile >
# Application Passwords). For the local Docker site use a LOCAL password.
WP_USER=api4genscan
WP_API=

# Backend database (first names, cities, divisions, documents).
# Relative to the program folder. Use a copy, never the production gsw.db.
GSW_DB=gsw.local.db

# Optional: Ollama model (the [AI] model in config has priority)
# OLLAMA_MODEL=qwen2.5vl:3b
